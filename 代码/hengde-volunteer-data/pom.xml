<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hengde</groupId>
        <artifactId>hengde-volunteer-parent</artifactId>
        <version>2.0.1</version>
        <relativePath>../hengde-volunteer-parent/pom.xml</relativePath> <!-- 读磁盘上的父 POM；别留空，留空时只认本地仓库里装过的那份 -->
    </parent>
    <artifactId>hengde-volunteer-data</artifactId>
    <name>hengde-volunteer-data</name>
    <description>hengde-volunteer-data</description>
    <packaging>jar</packaging>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-common</artifactId>
        </dependency>

        <!-- 认证域：志愿者注册数/管理团队数（VolunteerQueryService） -->
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-auth</artifactId>
        </dependency>

        <!-- 组织域：分队数量（SquadQueryService） -->
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-organization</artifactId>
        </dependency>

        <!-- 活动域：活动场次/总服务时长/参与人次（ActivityStatsService）。
             经此传递引入 redisson-spring-boot-starter，故本模块测试上下文也会装配 RedissonClient → 需 Redis 容器 -->
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-activity</artifactId>
        </dependency>

        <!-- 捐赠域：后台「数据汇总」里的微心愿 / 结对 / 捐书活动数据（DonateStatsService，V3 收尾批）。
             donate 在父 POM modules 里排在 data 之前，不成环 -->
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-donate</artifactId>
        </dependency>

        <!-- 数据汇总（V4 数据汇总批，Row 79）：社区 / 爱心企业 / 荣誉三块的口径各自落在 owner 域的只读 service，
             data 只组装。依赖方向 data → 它们，它们都不依赖 data（无环）；父 POM <modules> 里 data 因此排在 enterprise 之后 -->
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-social</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-enterprise</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-honor</artifactId>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- Lombok（common 里是 provided 不传递，本模块需单独声明） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：@SpringBootTest + Testcontainers-MySQL（+ Redis，因传递引入 redisson starter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hengde</groupId>
            <artifactId>hengde-volunteer-common</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 领域模块是被依赖的库，不可独立启动，关闭 repackage -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
