	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- 给测试 JVM 锁定 docker-java 的 Docker API 版本，解决新版 Docker Engine 拒绝默认旧版(1.32)的 400。
			     仅设系统属性，不绑定 docker host/端口，不关 Ryuk；Testcontainers 仍自动发现 Docker。 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<api.version>${tc.docker.api.version}</api.version>
					</systemPropertyVariables>
					<!--
						压力测试（JUnit @Tag("stress")）默认不跑：它们动辄几百个线程、跑一两分钟，
						放进日常 mvn test 会让人开始习惯性地 -DskipTests。要跑时：
						  ./mvnw test -Dtest.excludedGroups=none -Dgroups=stress -f ../hengde-volunteer-<模块>/pom.xml
						（none 是一个不存在的标签，等于「什么都不排除」。只传 -Dgroups=stress 而不改排除项，
						  会一条都不跑——排除优先于包含。）
						⚠️ 并发「正确性」用例（如 MallStockLockOrderTest 的锁序）不打这个标签，它们必须每次都跑；
						  stress 只给「量大、慢、主要看吞吐与不变式」的那一类。
					-->
					<excludedGroups>${test.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>

			<!--
				注解处理器路径显式声明。两条须一并记住：
				① 版本必须走 ${lombok.version}，与 dependencyManagement 里 classpath 上的 lombok 同源——
				   写死一个版本号会让「处理器」和「依赖」分属两个版本，出问题时症状与版本无关，极难联想。
				② 一旦声明 annotationProcessorPaths，就【关闭了从 classpath 自动发现处理器】。
				   当前无害（9 个模块都没有真的引入 mapstruct-processor / configuration-processor），
				   但 MapStruct 写在技术栈与本 POM 的 dependencyManagement 里——哪天有人按约定加上它，
				   处理器不会跑，报的是「找不到 XxxMapperImpl」，排查方向完全指错。
				   到那时要做的是把它也加进下面这个 path 列表，而不是去查 MapStruct 配置。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.1</version>
				<configuration>
					<source>17</source>
					<target>17</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
