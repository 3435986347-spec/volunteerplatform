# ============================================================
# 恒德志愿者平台 API · 生产环境变量模板（systemd EnvironmentFile 格式）
#
# 用法：复制到服务器 /etc/hengde/api.env 并填入真实值：
#   install -D -m 600 api.env.example /etc/hengde/api.env && vi /etc/hengde/api.env
# 留空的 ✅ 项不填会被 ProductionConfigGuard 拒绝启动（fail-fast，预期行为）。
# 变量含义与第三方开通步骤详见 文档/v1/上线checklist.md 第 4/5 节。
# ============================================================

# ===== profile（✅ 必填；不设 prod 会被守卫拦下）=====
SPRING_PROFILES_ACTIVE=prod

# ===== 数据库（✅ 别用 root/root；先建空库 hengde_volunteer utf8mb4）=====
DB_USER=hengde
DB_PWD=
# MySQL 不在本机时覆盖整条 url：
# SPRING_DATASOURCE_URL=jdbc:mysql://<host>:3306/hengde_volunteer?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# ===== Redis（生产务必设密码，不要裸跑公网）=====
SPRING_DATA_REDIS_PASSWORD=
# 不在本机时再覆盖：
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379

# ===== PII 加密密钥（✅✅ 最关键）=====
# 身份证/手机号用它加密入库。⚠️ 首次写入真实数据前定好，之后绝不能更换或丢失——
# 换了/丢了，库里已加密的 PII 全部无法解密。用强随机串（如 openssl rand -base64 32），离库备份保管。
SECURITY_AES_KEY=
SECURITY_HMAC_KEY=

# ===== 初始超管（✅ 首次启动前就设强密码；admin123 会被守卫拒启）=====
AUTH_SUPER_ADMIN_USERNAME=admin
AUTH_SUPER_ADMIN_PASSWORD=

# ===== 微信小程序（✅ 志愿者端必需；后台管理端不依赖）=====
WX_APPID=
WX_SECRET=

# ===== 短信 · 火山引擎（✅ 不开则注册/找回密码收不到验证码）=====
SMS_ENABLED=true
SMS_AK=
SMS_SK=
# 消息组 ID（注意：不是火山账号 ID），短信控制台里创建，形如 A123456
SMS_ACCOUNT=
# 验证码模板 ID（形如 ST_6f8c...）。每条模板的变量名都必须是 code，即正文写 ${code}。
# 分场景各配一条文案才贴切；只填 SMS_TPL_VERIFY 则所有场景共用它（注册也会收到登录文案）。
SMS_TPL_VERIFY=
SMS_TPL_REGISTER=
SMS_TPL_LOGIN=
SMS_TPL_PWD_RESET=
SMS_TPL_ADMIN_PWD_RESET=
SMS_TPL_CHANGE_PHONE=

# --- 通知类模板（协会 2026-08-11 报备，与验证码类是两套报备流程）---
# 只列【已接到业务事件】的 13 条；其余模板对应的功能尚未开发，配了也不会有人调用。
# 留空 = 该通知不发短信（站内提示不受影响）。启动时会 warn 列出「已接业务却没配」的那几条。
# ⚠️ 本文件由 systemd 的 EnvironmentFile 读取，【值后面不能跟行尾注释】——
#    `KEY=ST_xxx  # 说明` 会把注释连同空格一起当成值的一部分，模板 ID 随即失效且毫无征兆。
# 报名审核通过
SMS_TPL_ENROLL_APPROVED=
# 报名审核拒绝
SMS_TPL_ENROLL_REJECTED=
# 同小组代报名（被代者事先并不知情，必须告知）
SMS_TPL_ENROLL_POSITION=
# 活动即将开始（定时任务按场次发，默认提前 24h）
SMS_TPL_ACTIVITY_REMINDER=
# 活动取消
SMS_TPL_ACTIVITY_CANCELLED=
# 活动结束邀评
SMS_TPL_ACTIVITY_COMMENT=
# 服务时长与积分已发放
SMS_TPL_POINTS_CREDITED=
# 奖惩审核通过（Row 41 F「审核之后志愿者会收到提示」）
SMS_TPL_REWARD_PUNISH=
# 违规记录审核通过（此刻起对志愿者可见）
SMS_TPL_ACTIVITY_VIOLATION=
# 分队加入 / 报名管理团队 审核结果
SMS_TPL_ORG_JOIN_RESULT=
# 志愿小组 建组/加入 审核结果
SMS_TPL_GROUP_JOIN_RESULT=
# 积分商城兑换单审核结果（V3 卷批接上，当时漏配）
SMS_TPL_POINTS_ORDER_REVIEW=
# 投诉建议已答复（V4 投诉建议批）
SMS_TPL_COMPLAINT_REPLIED=

# --- 活动开始提醒（V39）---
ACTIVITY_REMINDER_ENABLED=true
ACTIVITY_REMINDER_LEAD_HOURS=24
ACTIVITY_REMINDER_BATCH_LIMIT=200
# ACTIVITY_REMINDER_CRON=0 5 * * * ?
# 注：现场紧急电话用下面「可选」段里既有的 HENGDE_ACTIVITY_EMERGENCYPHONE，不要在这里再加一个

# ===== 对象存储（✅ 不开则上传全是占位 URL）；恒德实例用火山 TOS =====
OSS_PROVIDER=volc
OSS_ENABLED=true
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=hengde-volunteer
OSS_AK=
OSS_SK=
# 绑了 CDN/自定义域名再填：
OSS_URL_PREFIX=
# 私有对象（证书等）签名 URL 的最大有效期（秒）。签名 URL 在有效期内等同凭证，上限须短。
# 超限直接拒绝而非截断；**必须 > 0**——配成 0/负数应用会拒绝启动（那等于关掉这道安全限制）。
OSS_PRESIGN_MAX_TTL_SECONDS=300

# ===== 志愿者协议（✅ 守卫强校验：版本非空、正文非占位）=====
AUTH_AGREEMENT_VERSION=1.0
# 协议正文（hengde.auth.agreement-text）是长文本，不适合放环境变量——
# 推荐写进 /opt/hengde/api/config/application-prod.yaml（见 部署说明.md 第 2 节示例）。

# ===== 功能开关 =====
# 实名二要素（腾讯云 faceid IdCardVerification，按次计费；仅「一致/不一致」两种结果收费）。
# 置 true 必须同时填下面两个密钥，否则 ProductionConfigGuard 拒绝启动；
# false 时只校验身份证号格式后放行，不调第三方、不产生费用。
AUTH_REALNAME_ENABLED=false
# 腾讯云控制台 → 访问管理(CAM) → API 密钥管理；与火山引擎的 AK/SK 无关，不可复用
REALNAME_SECRET_ID=
REALNAME_SECRET_KEY=
# 企业微信群校验 + 引导入群二维码
AUTH_WEWORK_ENABLED=false
AUTH_WEWORK_QR_URL=
# 开发登录：生产必须 false（true 会被守卫拒启）
AUTH_DEV_LOGIN_ENABLED=false

# ===== 可选 =====
# 活动现场「紧急上报」预设电话（hengde.activity.emergency-phone，小程序负责人端 tel: 拨号）
HENGDE_ACTIVITY_EMERGENCYPHONE=

# ===== 排行榜快照（V2 第 2 批；全部有默认值，不填即用默认）=====
# 往期榜单的名次要冻结，否则事后的活动补录/考勤修正/积分调整会让历史月份的排行不断变化。
# 冻结由应用内的 Spring @Scheduled 定时任务完成。它是**进程内**调度：多实例部署时每个实例都会到点触发，
# 但快照生成按「周期」上了 Redis 分布式锁（lock:honor:ranking-snapshot:），并发只会有一个真正执行、
# 其余看到「已存在」而跳过，不会写坏数据。若将来要做真正的集中调度（可视化触发/失败重试/执行日志），
# 再接 XXL-Job（需额外部署 xxl-job-admin 调度中心）。
# HONOR_RANKING_SNAPSHOT_ENABLED=true
# HONOR_RANKING_SNAPSHOT_CRON=0 30 0 * * ?
# 周期结束后的冷静期（天）。时长要等秘书部确认、积分要等发放，月末 0 点就冻会把没结算完的数据定死
# HONOR_RANKING_FREEZE_DELAY_DAYS=7
# HONOR_RANKING_SNAPSHOT_TOP_N=100

# ===== 电子证书（V2 第 4 批；全部有默认值，不填即用默认）=====
# 下载签名 URL 有效期（秒）。签名 URL 在有效期内等同凭证，另受 OSS_PRESIGN_MAX_TTL_SECONDS 二次约束
# HONOR_CERTIFICATE_DOWNLOAD_URL_TTL_SECONDS=120
#
# 补偿扫描：自动建证书挂在**进程内、不持久**的事件上，而秘书部确认的 CAS 是一次性的（0→1），
# 事件一丢就永不再触发。本任务是唯一的自动兜底，**关掉它等于接受「偶尔有人永久拿不到证书且无人发现」**，
# 仅建议排障时临时关。
# HONOR_CERTIFICATE_RECONCILE_ENABLED=true
# HONOR_CERTIFICATE_RECONCILE_CRON=0 15 * * * ?
#
# ⚠️ 以下三项**必须 > 0，配成 0/负数应用会拒绝启动**——它们配错都不报错，只会静默失效：
#   batch-size 配 0        → 每批查回空列表、循环立刻退出，补偿「看着在跑、实际什么也不补」
#   lookback-hours 配 0    → 窗口为空，同上
#   max-creates-per-run 配 0 → 一张也补不出来
# HONOR_CERTIFICATE_RECONCILE_BATCH_SIZE=500
#
# 回看窗口（小时）。**不能取消下界**：不加下界会从库里第一条已确认考勤扫起，第一次跑就给
# 所有历史活动批量发证——而「改造前已结束的活动是否补发」协会尚未答复，等于让定时任务替协会
# 把待决问题答了，且证书发出去收不回。要补历史请用 POST /a/honor/certificates/reconcile 显式圈范围。
# HONOR_CERTIFICATE_RECONCILE_LOOKBACK_HOURS=72
#
# 单次补发封顶。人工补发接口同步执行，而网关 proxy_read_timeout 是 60s：一次几千张会在网关 504
# 而服务端还在跑，管理员看到失败又点一次就两轮重叠白烧。达到上限回 hasMore=true，再点一次即可。
# HONOR_CERTIFICATE_RECONCILE_MAX_CREATES_PER_RUN=1000

# ---------- 积分商城（V3 商城批 / 商城快递批）----------
# 自提点：审核通过时快照进兑换单
# DONATE_MALL_PICKUP_NAME=协会办公室
# DONATE_MALL_PICKUP_ADDRESS=雷州市某某路 1 号
# DONATE_MALL_PICKUP_PHONE=0759-0000000
#
# 快递寄送，默认关闭：快递费与积分折算汇率要协会给（清单③）。
# 现金付快递费 / 商品带现金部分还需要微信支付已开通（TRADE_WECHAT_ENABLED），否则那类单下单即被拒；
# 积分抵扣快递费不需要商户资质
# DONATE_MALL_EXPRESS_ENABLED=false
# DONATE_MALL_EXPRESS_FEE_FEN=1000
# DONATE_MALL_EXPRESS_POINTS_PER_YUAN=100
# DONATE_MALL_EXPRESS_AUTO_RECEIVE_DAYS=15
# DONATE_MALL_PAY_TIMEOUT_MINUTES=15

# ---------- 年级自动升级（V4 个人中心补全批）----------
# 每天跑、按学年（9 月 1 日为界）幂等；分界年级（六年级/九年级/高三/大三/大四/大五）不替他升，挂提示让本人改
# USER_GRADE_UPGRADE_ENABLED=true
# USER_GRADE_UPGRADE_CRON=0 20 3 * * ?

# ---------- 志愿者证（V4 志愿者证批）----------
# 小程序码打开的页面须在已发布版本里存在；H5 核验地址是小程序码生成不了时普通二维码的内容（留空则只有本小程序扫得出）
# USER_CARD_MINIAPP_PAGE=pages/volunteer-card/verify
# USER_CARD_MINIAPP_ENV_VERSION=release
# USER_CARD_VERIFY_URL=
# USER_CARD_CODE_CACHE_SECONDS=604800

# ---------- 爱心企业积分账本（V4 爱心企业批）----------
# 赞助商品兑换单「已领取」后补记企业积分；回看窗口（小时）之外漏掉的在后台显式补
# ENTERPRISE_POINTS_CREDIT_ENABLED=true
# ENTERPRISE_POINTS_CREDIT_CRON=0 */10 * * * ?
# ENTERPRISE_POINTS_CREDIT_LOOKBACK_HOURS=72

# ---------- 投诉建议（V4 投诉建议批）----------
# 新工单默认进哪个部门：须与后台账号的「部门」一字不差，否则没人看得到
# DATA_COMPLAINT_DEFAULT_DEPARTMENT=监察部
# DATA_COMPLAINT_DAILY_LIMIT=5
# DATA_COMPLAINT_SMS_REPLY_MAX_CHARS=30

# ---------- 在线捐款（V3 捐款批：众筹捐款 / 结对捐款）----------
# 需要微信支付已开通（TRADE_WECHAT_ENABLED），否则在线捐款当场被拒、不落库
# DONATE_DONATION_PAY_TIMEOUT_MINUTES=30
# DONATE_DONATION_MAX_AMOUNT=50000

# ---------- 微心愿（V3 微心愿批）----------
# 物资接收地址（Row 12 C：认领人按要求把物资寄到协会办公室）。收件的永远是办公室、心愿只决定寄什么，
# 所以是一份配置而不是每个心愿一份；只有认领人在心愿详情里看得到。
# ⚠️ 留空不会报错，认领人看到的就是一片空白、不知道该往哪寄——上线前必须填。
# DONATE_WISH_RECV_NAME=恒德协会 微心愿组
# DONATE_WISH_RECV_PHONE=0759-0000000
# DONATE_WISH_RECV_ADDRESS=雷州市某某路 1 号 恒德爱心公益协会

# ---------- 快递100（V3 捐书批查询 / 物流推送批订阅）----------
# 查询与订阅推送是两个计费项，开关分开、共用一个账号的授权 key。都默认关闭。
# KUAIDI100_ENABLED=false
# KUAIDI100_CUSTOMER=
# KUAIDI100_KEY=
# KUAIDI100_POLL_ENABLED=true
# KUAIDI100_POLL_INTERVAL_MINUTES=120
#
# 订阅推送：⚠️ 开启要求 KUAIDI100_KEY 已配且回调地址是已备案域名的 https（生产守卫启动时校验）。
# 回调地址不带查询参数，运单 id 由系统拼上
# KUAIDI100_PUSH_ENABLED=false
# KUAIDI100_PUSH_CALLBACK_URL=https://你的已备案域名/api/callback/logistics/kuaidi100
# KUAIDI100_PUSH_RETRY_INTERVAL_MINUTES=30
# KUAIDI100_PUSH_MAX_ATTEMPTS=5

# ---------- 收付 / 微信支付（V3 trade 批）----------
# 默认关闭：没有商户资质时保持 false，下单会被明确拒绝而不是伪造成功。
# ⚠️ 开启前三样缺一不可：商户号、APIv3 密钥与商户证书、**已备案域名的 https 回调地址**。
# TRADE_WECHAT_ENABLED=false
# TRADE_WECHAT_MCH_ID=
# TRADE_WECHAT_APP_ID=
# TRADE_WECHAT_API_V3_KEY=
# TRADE_WECHAT_SERIAL_NO=
# TRADE_WECHAT_PRIVATE_KEY=
# TRADE_WECHAT_PAY_NOTIFY_URL=https://你的已备案域名/api/callback/trade/wechat/pay
# TRADE_WECHAT_REFUND_NOTIFY_URL=https://你的已备案域名/api/callback/trade/wechat/refund
#
# 交易单有效期（分钟）。众筹 / 结对捐款不占资源，默认给一天，别照搬商城的 15 分钟
# TRADE_TTL_MINUTES=15
# TRADE_TTL_CROWDFUND=1440
# TRADE_TTL_PAIR=1440
#
# 分钟级扫描（支付回写四道里的第二道）。⚠️ 关掉它，回调一丢就再没人把单子推到终态
# TRADE_SCAN_ENABLED=true
# TRADE_SCAN_CRON=0 */2 * * * ?
# TRADE_SCAN_BATCH=100
# TRADE_SCAN_MIN_AGE_MINUTES=2
#
# 每日对账（第四道）：核对前一天，结果在后台「对账记录」里看；默认凌晨 3:30
# TRADE_RECONCILE_ENABLED=true
# TRADE_RECONCILE_CRON=0 30 3 * * ?

# 日志级别（默认 INFO）
# LOGGING_LEVEL_COM_HENGDE=INFO
